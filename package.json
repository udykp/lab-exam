{
  "name": "securelab",
  "productName": "SecureLab",
  "version": "1.0.0",
  "description": "Secure Exam Platform Desktop Client",
  "main": "main.js",
  "scripts": {
    "start": "electron . --no-sandbox",
    "package": "electron-builder --linux deb"
  },
  "dependencies": {
    "monaco-editor": "^0.56.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.securelab.app",
    "productName": "SecureLab",
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Education",
      "icon": "icon.png"
    },
    "files": [
      "**/*",
      "bin/**/*",
      "web/**/*",
      "!dist/**/*",
      "!node_modules/**/*"
    ]
  }
}
