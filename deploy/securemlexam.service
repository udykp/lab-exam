[Unit]
Description=Secure MLExam Server Daemon
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/securemlexam
ExecStart=/opt/securemlexam/server
Restart=always
RestartSec=5
Environment=LISTEN_ADDR=0.0.0.0:8080
Environment=DB_PATH=/var/lib/securemlexam/exam.db
Environment=JWT_SECRET=secure-ml-exam-production-secret-key-2026

[Install]
WantedBy=multi-user.target
